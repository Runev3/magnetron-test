    },
    "QuestionDescription": "Denk aan de microgolf die je net gebruikt hebt. In hoeverre ben je het eens met de volgende uitspra",
    "NextChoiceId": 11,
    "NextAnswerId": 6,
    "QuestionText": "Denk aan de microgolf die je net gebruikt hebt. In hoeverre ben je het eens met de volgende uitspraken?",
    "DataExportTag": "model3_sus",
    "QuestionType": "Matrix",
    "Selector": "Likert",
    "SubSelector": "SingleAnswer",
    "Configuration": {
     "QuestionDescriptionOption": "UseText",
     "TextPosition": "inline",
     "ChoiceColumnWidth": 40,
     "RepeatHeaders": "none",
     "WhiteSpace": "OFF",
     "MobileFirst": true
    },
    "Choices": {
     "1": {
      "Display": "Ik denk dat ik deze microgolf graag regelmatig zou gebruiken."
     },
     "2": {
      "Display": "Ik vond de bediening onnodig complex."
     },
     "3": {
      "Display": "Ik vond de microgolf makkelijk te gebruiken."
     },
     "4": {
      "Display": "Ik denk dat ik hulp van iemand met technische kennis nodig heb om deze microgolf te kunnen gebruiken."
     },
     "5": {
      "Display": "Ik vond dat de verschillende functies van deze microgolf goed op elkaar aansloten."
     },
     "6": {
      "Display": "Ik vond dat er te veel inconsistentie in de bediening zat."
     },
     "7": {
      "Display": "Ik kan me voorstellen dat de meeste mensen zeer snel leren om deze microgolf te gebruiken."
     },
     "8": {
      "Display": "Ik vond de bediening erg omslachtig."
     },
     "9": {
      "Display": "Ik voelde me erg zeker tijdens het gebruik van deze microgolf."
     },
     "10": {
      "Display": "Ik moest veel leren voordat ik met deze microgolf aan de slag kon."
     }
    },
    "ChoiceOrder": [
     "1",
     "2",
     "3",
     "4",
     "5",
     "6",
     "7",
