   "SurveyID": "SV_microgolfUX0001",
   "Element": "SQ",
   "PrimaryAttribute": "QID31",
   "SecondaryAttribute": "Denk aan de microgolf die je net gebruikt hebt. In hoeverre ben je het eens met de volgende uitspra",
   "TertiaryAttribute": null,
   "Payload": {
    "QuestionID": "QID31",
    "DataVisibility": {
     "Private": false,
     "Hidden": false
    },
    "Language": [],
    "Validation": {
     "Settings": {
      "ForceResponse": "ON",
      "ForceResponseType": "ON",
